# Copied to .env by `npm run setup` (which also fills in the reviewer). .env is git-ignored.
PORT=4749
HOST=127.0.0.1

# Where goals, evidence, penalties and media are stored. Must be outside this repo.
YOMEPAY_DATA_DIR=~/.yomepay/data

# Your and your wife's ntfy topics (made by `npm run setup`). Kept outside the repo.
YOMEPAY_SECRETS=~/.yomepay/secrets.json

# true = trial mode: messages meant for your wife come to you. `npm run go-live -- --yes` turns it off.
YOMEPAY_DRY_RUN=true

# Who reviews photos, videos, texts and check-ins: claude (Claude Code) or codex, signed in on this Mac.
# No API key is used. off = you run /yome-review yourself.
YOMEPAY_REVIEWER=off
YOMEPAY_REVIEWER_BIN=

# GitHub goals: whose pushes count, comma-separated (a push to any of their repositories counts).
# Empty = every account the gh CLI is signed in to (`gh auth login` once per account). A goal can also name its own.
YOMEPAY_GITHUB_USER=

# HTTPS port on your tailnet for the phone. Change it if another app already serves on 443.
YOMEPAY_HTTPS_PORT=443

# Optional: only these Tailscale logins may use the app (comma separated).
YOMEPAY_ALLOWED_USERS=

# Testing only: start the clock at this time, e.g. 2026-10-28T21:59:00+09:00
YOMEPAY_NOW=
